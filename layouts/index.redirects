{{- /*
  _redirects — Netlify redirect rules, one 301 per page alias.

  Each page's `aliases` front matter is the single source (09-blog-migration.md
  §"Redirects: one source, true 301s"); Hugo's own alias pages are off
  (disableAliases in hugo.toml). Netlify reads this file before netlify.toml,
  so netlify.toml's /* legacy fall-through can't shadow these rules. Netlify
  matches with or without the trailing slash, so one line per alias covers
  both forms. Drafts and unpublished pages are not in site.Pages, so they get
  no rule.
*/ -}}
# Generated by Hugo from page aliases (layouts/index.redirects). Do not edit.
{{ range site.Pages -}}
  {{- $to := .RelPermalink -}}
  {{- range .Aliases -}}
    {{- . }} {{ $to }} 301
{{ end -}}
{{- end -}}
